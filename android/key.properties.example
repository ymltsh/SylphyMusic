# Copy to key.properties locally; never commit your keystore or credentials.
# Relative paths resolve from android/. Use forward slashes on Windows.
# Restore the existing production key; do not generate a replacement for updates.
storeFile=../.private/android-signing/sylphy-release.p12
storePassword=REPLACE_LOCALLY
keyAlias=sylphy-release
